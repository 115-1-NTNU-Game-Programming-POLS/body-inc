{
  "version": 1,
  "presets": {
    "paper": { "texture": "fx-paper", "speed": [60, 120], "life": 0.3 },
    "ink": { "texture": "fx-ink", "speed": [60, 120], "life": 0.3 },
    "fuzz": { "texture": "fx-fuzz", "speed": [10, 30], "life": 0.6 },
    "sweat": { "texture": "fx-sweat", "speed": [30, 40], "life": 0.4 }
  },
  "events": {
    "fire": { "sound": "staple" },
    "swing": { "sound": "swing" },
    "toolSwapped": { "sound": "swap" },
    "guardRaised": { "sound": "guard" },
    "dodge": { "sound": "dodge" },
    "telegraph": { "sound": "telegraph.{tier}" },
    "forcedLeave": { "sound": "yawn" },
    "gaugeFull": { "sound": "ready" },
    "stampRaised": { "sound": "stampUp" },
    "doorEntered": { "sound": "door" },
    "switchChanged": { "sound": "click" },
    "switchCooling": { "sound": "nope", "note": "switch.cooling" },
    "boxDelivered": { "sound": "thunk" },
    "portFilled": { "sound": "thunk" },
    "talk": { "sound": "blip" },
    "bedUse": { "sound": "yawn" },
    "dialogueOpened": { "sound": "blip" },
    "handbookUnlocked": { "sound": "unlock" },
    "cardOpened": { "sound": "card" },
    "cardChosen": { "sound": "choose" },
    "toolGranted": { "sound": "unlock" },
    "rescueStep": { "sound": "rescue.{outcome}" },
    "rescueDone": { "sound": "done" },
    "examResult": { "sound": "done" },
    "hit": { "sound": "hit", "flashTarget": 2, "particles": [{ "preset": "paper", "count": 5 }, { "preset": "ink", "count": 3 }] },
    "caseClosed": { "sound": "closed", "closeOut": true, "particles": [{ "preset": "paper", "count": 12 }], "note": "stamp.case_closed" },
    "bound": { "sound": "cling", "flashTarget": 4, "particles": [{ "preset": "ink", "count": 5 }], "note": "bind.bound" },
    "dispersed": { "sound": "poof", "particles": [{ "preset": "fuzz", "count": 8 }] },
    "reformed": { "sound": "reform" },
    "respawned": { "sound": "respawn" },
    "bumpWall": { "sound": "bump" },
    "immuneBounce": { "sound": "boing", "bounce": true, "note": "solution.{solution}" },
    "heartLost": { "sound": "heart", "flashOperator": 2, "shake": { "px": 4, "seconds": 0.12 }, "particles": [{ "preset": "sweat", "count": 1 }] },
    "perfectDodge": { "sound": "perfect", "note": "perfect_dodge" },
    "parry": { "sound": "parry", "shake": { "px": 3, "seconds": 0.1 }, "particles": [{ "preset": "paper", "count": 6 }, { "preset": "ink", "count": 3 }], "note": "folder.parry" },
    "blocked": { "sound": "blocked", "particles": [{ "preset": "paper", "count": 3 }], "note": "folder.blocked" },
    "toasted": { "sound": "clink", "note": "cheers.toasted" },
    "refused": { "sound": "refuse", "particles": [{ "preset": "paper", "count": 4 }] },
    "refusalSaid": { "note": "refusal.line.{line}" },
    "pieRaised": { "sound": "shield", "note": "pie.raised.{sleepy}" },
    "pieBlocked": { "sound": "shield", "particles": [{ "preset": "paper", "count": 4 }] },
    "unloadRaised": { "sound": "poof", "note": "unload.raised" },
    "chunkDissolved": { "sound": "unlock", "particles": [{ "preset": "paper", "count": 6 }], "note": "stomach.chunk_gone" },
    "canTaken": { "sound": "pick", "pulse": { "amount": 0.01, "beats": 6, "seconds": 3 } },
    "teaTaken": { "sound": "pick", "note": "stomach.tea" },
    "palpitation": { "sound": "heartbeat", "note": "can.palpitation" },
    "canDisco": { "sound": "disco", "note": "can.disco" },
    "shieldBlocked": { "sound": "blocked", "bounce": true, "particles": [{ "preset": "paper", "count": 3 }], "note": "shield.blocked" },
    "shieldBroken": { "sound": "crack", "flashTarget": 4, "shake": { "px": 3, "seconds": 0.1 }, "particles": [{ "preset": "paper", "count": 8 }, { "preset": "ink", "count": 4 }], "note": "shield.broken" },
    "backedOff": { "sound": "boing", "bounce": true, "note": "cheers.backed_off" },
    "stampLanded": { "sound": "stampDown", "shake": { "px": 6, "seconds": 0.15 }, "particles": [{ "preset": "ink", "count": 10 }], "note": "stamp.rejected" },
    "stampVoid": { "sound": "nope", "bounce": true, "note": "stamp_void.{solution}" },
    "clung": { "sound": "cling", "particles": [{ "preset": "fuzz", "count": 4 }] },
    "forcedNap": { "sound": "yawn", "note": "forced_nap" },
    "bossStage": { "sound": "stage", "note": "boss_stage.{stage}" },
    "bossDrink": { "sound": "gulp", "note": "boss.drink" },
    "bossSummon": { "sound": "poof", "particles": [{ "preset": "fuzz", "count": 6 }] },
    "powerCut": { "sound": "powerdown", "shake": { "px": 4, "seconds": 0.2 }, "particles": [{ "preset": "fuzz", "count": 14 }], "note": "boss.power_cut" },
    "proposalRejected": { "shake": { "px": 6, "seconds": 0.15 }, "particles": [{ "preset": "ink", "count": 12 }], "note": "proposal.rejected" },
    "bossDefeated": { "sound": "done", "closeOut": true, "particles": [{ "preset": "paper", "count": 20 }], "note": "boss.defeated" },
    "bossBreath": { "sound": "breath", "note": "boss.toast.breathing" },
    "bossRound": { "sound": "stage", "note": "boss.toast.next_round" },
    "snackStage": { "sound": "stage", "note": "boss.snack.next_stage.{stage}" },
    "snackShrugged": { "sound": "boing", "bounce": true },
    "snackWoken": { "sound": "woke.mixer", "note": "sleep.woke.mixer" },
    "snackRested": { "sound": "unlock", "note": "boss.snack.rested" },
    "snackStampRefused": { "sound": "nope", "bounce": true, "note": "boss.snack.stamp_refused" },
    "bossConceded": { "sound": "done", "particles": [{ "preset": "paper", "count": 12 }], "note": "boss.toast.conceded" },
    "doorLocked": { "sound": "locked", "note": "door.locked.{lock}" },
    "pickedUp": { "sound": "pick", "note": "pickup.{itemType}" },
    "bedRefused": { "sound": "bad", "note": "bed.refused.{bedType}" },
    "portOpened": { "sound": "unlock" },
    "portClosed": { "sound": "locked" },
    "sleepInterrupted": { "sound": "woke.{cause}", "note": "sleep.woke.{cause}" },
    "napped": { "sound": "yawn", "note": "napped" },
    "handsFull": { "sound": "nope", "note": "memory.hands_full" },
    "checkpointSaved": { "sound": "punch", "note": "checkpoint.saved" },
    "crateTaken": { "sound": "thunk", "particles": [{ "preset": "paper", "count": 6 }], "note": "liver.crate_taken" },
    "mixerFed": { "sound": "thunk" },
    "boxChilled": { "sound": "thunk", "note": "stomach.chilled" },
    "parcelOut": { "sound": "pick" },
    "orderThrown": { "sound": "thunk", "note": "stomach.order_in" },
    "orderReturned": { "sound": "page", "particles": [{ "preset": "paper", "count": 6 }], "note": "stomach.order_back" },
    "deliveryThrown": { "sound": "thunk" },
    "mixerProtest": { "sound": "bad", "atEvent": true, "shake": { "px": 5, "seconds": 0.2 }, "particles": [{ "preset": "paper", "count": 12 }], "note": "stomach.mixer_protest" },
    "mixerJammed": { "sound": "bad", "shake": { "px": 4, "seconds": 0.15 }, "particles": [{ "preset": "paper", "count": 10 }], "note": "stomach.mixer_jammed" },
    "dizzyChanged": { "sound": "dizzy.{dizzy}", "note": "dizzy.{dizzy}" },
    "examHit": { "sound": "heart", "flashOperator": 2, "shake": { "px": 3, "seconds": 0.1 }, "particles": [{ "preset": "ink", "count": 3 }] },
    "examAnswered": { "sound": "exam.{how}", "note": "exam.answered.{how}" },
    "examStacked": { "sound": "cling", "particles": [{ "preset": "fuzz", "count": 10 }] },
    "proofStamped": { "sound": "proof.{ok}", "particles": [{ "preset": "ink", "count": 6 }], "note": "exam.stamp.{ok}" },
    "bonusShown": { "sound": "unlock", "note": "exam.bonus" },
    "examBreak": { "sound": "page", "note": "exam.break" }
  }
}
