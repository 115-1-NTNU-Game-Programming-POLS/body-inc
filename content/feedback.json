{
  "version": 1,
  "presets": {
    "paper": { "texture": "fx-paper", "speed": [60, 120], "life": 0.3 },
    "ink": { "texture": "fx-ink", "speed": [60, 120], "life": 0.3 },
    "fuzz": { "texture": "fx-fuzz", "speed": [10, 30], "life": 0.6 },
    "sweat": { "texture": "fx-sweat", "speed": [30, 40], "life": 0.4 }
  },
  "events": {
    "hit": { "flashTarget": 2, "particles": [{ "preset": "paper", "count": 5 }, { "preset": "ink", "count": 3 }] },
    "caseClosed": { "closeOut": true, "particles": [{ "preset": "paper", "count": 12 }], "note": "stamp.case_closed" },
    "dispersed": { "particles": [{ "preset": "fuzz", "count": 8 }] },
    "immuneBounce": { "bounce": true, "note": "solution.{solution}" },
    "heartLost": { "flashOperator": 2, "shake": { "px": 4, "seconds": 0.12 }, "particles": [{ "preset": "sweat", "count": 1 }] },
    "perfectDodge": { "note": "perfect_dodge" },
    "parry": { "shake": { "px": 3, "seconds": 0.1 }, "particles": [{ "preset": "paper", "count": 6 }, { "preset": "ink", "count": 3 }], "note": "folder.parry" },
    "blocked": { "particles": [{ "preset": "paper", "count": 3 }], "note": "folder.blocked" },
    "toasted": { "note": "cheers.toasted" },
    "refused": { "particles": [{ "preset": "paper", "count": 4 }] },
    "refusalSaid": { "note": "refusal.line.{line}" },
    "backedOff": { "bounce": true, "note": "cheers.backed_off" },
    "stampLanded": { "shake": { "px": 6, "seconds": 0.15 }, "particles": [{ "preset": "ink", "count": 10 }], "note": "stamp.rejected" },
    "stampVoid": { "bounce": true, "note": "stamp_void.{solution}" },
    "clung": { "particles": [{ "preset": "fuzz", "count": 4 }] },
    "forcedNap": { "note": "forced_nap" },
    "bossStage": { "note": "boss_stage.{stage}" },
    "bossDrink": { "note": "boss.drink" },
    "bossSummon": { "particles": [{ "preset": "fuzz", "count": 6 }] },
    "powerCut": { "shake": { "px": 4, "seconds": 0.2 }, "particles": [{ "preset": "fuzz", "count": 14 }], "note": "boss.power_cut" },
    "proposalRejected": { "shake": { "px": 6, "seconds": 0.15 }, "particles": [{ "preset": "ink", "count": 12 }], "note": "proposal.rejected" },
    "bossDefeated": { "closeOut": true, "particles": [{ "preset": "paper", "count": 20 }], "note": "boss.defeated" },
    "bossBreath": { "note": "boss.toast.breathing" },
    "bossRound": { "note": "boss.toast.next_round" },
    "bossConceded": { "particles": [{ "preset": "paper", "count": 12 }], "note": "boss.toast.conceded" },
    "doorLocked": { "note": "door.locked.{lock}" },
    "pickedUp": { "note": "pickup.{itemType}" },
    "bedRefused": { "note": "bed.refused.{bedType}" },
    "napped": { "note": "napped" },
    "checkpointSaved": { "note": "checkpoint.saved" },
    "crateTaken": { "particles": [{ "preset": "paper", "count": 6 }], "note": "liver.crate_taken" },
    "dizzyChanged": { "note": "dizzy.{dizzy}" },
    "examHit": { "flashOperator": 2, "shake": { "px": 3, "seconds": 0.1 }, "particles": [{ "preset": "ink", "count": 3 }] },
    "examAnswered": { "note": "exam.answered.{how}" },
    "examStacked": { "particles": [{ "preset": "fuzz", "count": 10 }] },
    "proofStamped": { "particles": [{ "preset": "ink", "count": 6 }], "note": "exam.stamp.{ok}" },
    "bonusShown": { "note": "exam.bonus" },
    "examBreak": { "note": "exam.break" }
  }
}
