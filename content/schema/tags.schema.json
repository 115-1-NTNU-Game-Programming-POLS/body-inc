{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TagsFile",
  "description": "State tag dictionary (design doc 13.4) and modifiers as condition aliases (8.7). Cross-checks (duplicate names, hours only with duration hours, unit only on number tags, modifier conditions) are in core/tags/dictionary.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tags", "modifiers"],
  "properties": {
    "version": { "const": 1 },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/Tag" } },
    "modifiers": { "type": "array", "items": { "$ref": "#/$defs/Modifier" } }
  },
  "$defs": {
    "Fact": {
      "description": "Fact-check table entry: a row number, \"pending:<n>\" for the pending list, or \"general\".",
      "type": "string",
      "pattern": "^(\\d+|pending:\\d+|general)$"
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "sources", "duration", "facts"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "enum": ["number", "boolean"] },
        "unit": { "description": "Display unit; number tags only.", "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["card", "event", "chapter", "rule"] } },
        "duration": { "enum": ["persistent", "hours", "untilWake", "nextDay"] },
        "hours": { "description": "Span in rule hours; required with duration \"hours\" and only then.", "type": "number", "exclusiveMinimum": 0 },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" } }
      }
    },
    "Modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "facts"],
      "properties": {
        "name": { "type": "string", "pattern": "^mod\\.[a-z][a-z0-9_]*$" },
        "when": { "description": "Condition over tags only (no modifier may use another).", "type": "string", "minLength": 1 },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" } }
      }
    }
  }
}
